# 이 파일을 복사해 .env 로 저장한 뒤 값을 채운다. .env 는 커밋하지 않는다.
# GitHub Actions 에서는 같은 이름을 저장소 Secrets(키·토큰) / Variables(AUTO_PUBLISH_DISABLED)로 등록한다.
# 이미 설정된 환경변수가 .env 보다 우선한다.
# 값을 채운 뒤 `python settings.py` 로 점검한다 (값은 화면에 출력하지 않는다).

# ── Threads (PLAN 2-1) ──────────────────────────────────
# 숫자로 된 스레드 사용자 ID 하나만 (규칙 1: 계정 1개)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_APP_SECRET=
# 장기 토큰 발급일 YYYY-MM-DD (KST). 60일 유효, 만료 10일 전부터 발행 로그에 경고
THREADS_TOKEN_ISSUED_AT=

# ── LLM ──────────────────────────────────────────────────
# 생성: Gemini (config.yaml generator_model)
GEMINI_API_KEY=
# 선택. 생성 모델이 사용량 한도에 걸릴 때만 쓴다 (config.yaml generator_fallback_model)
OPENAI_API_KEY=
# 검수: Claude (config.yaml reviewer_model). 생성과 다른 회사여야 한다
ANTHROPIC_API_KEY=

# ── 알림 (일일 요약·자동 정지) ────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Supabase (이 테스트 전용 새 프로젝트) ───────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── 안전 스위치 ─────────────────────────────────────────
# true 면 발행 작업이 아무것도 하지 않고 정상 종료한다 (규칙 8)
AUTO_PUBLISH_DISABLED=false
# 8장 체크리스트와 검수자 시험지를 모두 통과하고 사람이 직접 false 로 바꾸기 전까지 true 유지 (규칙 9)
# 시험지 불합격 상태면 false 여도 발행 코드가 실행을 거부한다
DRY_RUN=true
